// Build settings shared by every iOS configuration. Committed.
// Version.xcconfig is written by `pebble ios` from PEBBLE_VERSION (Saves.swift)
// and packaging/Info.plist so the Mac and iOS apps always report the same version.
// Local.xcconfig holds your DEVELOPMENT_TEAM (see Local.xcconfig.example).

PRODUCT_NAME = Pebble
PRODUCT_BUNDLE_IDENTIFIER = net.stonekitty.pebble
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_VERSION = 5.0
CODE_SIGN_STYLE = Automatic
INFOPLIST_FILE = PebbleiOS/Info.plist
GENERATE_INFOPLIST_FILE = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
MARKETING_VERSION = 0.0.0
CURRENT_PROJECT_VERSION = 1

#include? "Version.xcconfig"
#include? "Local.xcconfig"
